# Copy this file to exp/config.env only when you need to override defaults.
# Existing environment variables take precedence because every assignment is conditional.

: "${EXP_CUDA_VISIBLE_DEVICES:=0}"
: "${EXP_HOST:=127.0.0.1}"
: "${EXP_PORT:=8000}"
: "${EXP_API_KEY:=local-eval}"

: "${EXP_IN_DOMAIN_COUNT:=25}"
: "${EXP_OUT_DOMAIN_COUNT:=25}"
: "${EXP_EVAL_SEED:=42}"
: "${EXP_IN_DOMAIN_REPO:=swesmith/scanny__python-pptx.278b47b1}"

: "${EXP_SERVER_MAX_LENGTH:=16384}"
: "${EXP_SERVER_MAX_NEW_TOKENS:=2048}"
: "${EXP_TEMPERATURE:=0}"
: "${EXP_MAX_STEPS:=40}"
: "${EXP_MAX_SECONDS:=1800}"
: "${EXP_MAX_TOKENS:=100000}"
: "${EXP_CONTEXT_WINDOW_TOKENS:=57344}"
: "${EXP_WORKERS:=1}"

# Optional explicit path overrides:
# EXP_BASE_MODEL=/absolute/path/to/Qwen3.5-9B
# EXP_LORA_ADAPTER=/absolute/path/to/checkpoint-40
# EXP_EVAL_DATASET=/absolute/path/to/swesmith_train
# EXP_EVAL_MANIFEST=/absolute/path/to/eval_set.json
# EXP_TEST_IDS=/absolute/path/to/test_ids.txt
# EXP_RUN_TAG=my-frozen-ab-test
