# Copy this file to exp/config.env only when you need to override defaults.
# Existing environment variables take precedence because every assignment is conditional.

: "${CUDA_VISIBLE_DEVICES:=0}"
: "${HOST:=127.0.0.1}"
: "${PORT:=8000}"
: "${API_KEY:=local-eval}"

: "${IN_DOMAIN_COUNT:=25}"
: "${OUT_DOMAIN_COUNT:=25}"
: "${EVAL_SEED:=20260903}"
: "${IN_DOMAIN_REPO:=swesmith/scanny__python-pptx.278b47b1}"

: "${SERVER_MAX_LENGTH:=16384}"
: "${SERVER_MAX_NEW_TOKENS:=2048}"
: "${TEMPERATURE:=0}"
: "${MAX_STEPS:=40}"
: "${MAX_SECONDS:=1800}"
: "${MAX_TOKENS:=100000}"
: "${WORKERS:=1}"

# Optional explicit path overrides:
# BASE_MODEL=/absolute/path/to/Qwen3.5-9B
# LORA_ADAPTER=/absolute/path/to/checkpoint-40
# EVAL_DATASET=/absolute/path/to/swesmith_train
# EVAL_MANIFEST=/absolute/path/to/eval_set.json
# TEST_IDS=/absolute/path/to/test_ids.txt
# RUN_TAG=my-frozen-ab-test

